<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>LiveLingo - Real-time Translation SPA</title>
<script type="module" src="https://cdn.jsdelivr.net/npm/@videojs/html/cdn/video-minimal.js"></script>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&amp;family=Inter:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "outline-variant": "#c6c6c6",
                        "surface-tint": "#5f5e5e",
                        "on-tertiary-fixed-variant": "#e4e2e2",
                        "tertiary-container": "#757474",
                        "surface-bright": "#f9f9f9",
                        "primary-container": "#3c3b3b",
                        "on-primary-fixed-variant": "#e5e2e1",
                        "on-secondary-container": "#1b1c1c",
                        "error": "#ba1a1a",
                        "surface-variant": "#e2e2e2",
                        "on-tertiary": "#e4e2e2",
                        "outline": "#777777",
                        "on-secondary-fixed-variant": "#3b3b3b",
                        "tertiary-fixed": "#5e5e5e",
                        "primary-fixed": "#5f5e5e",
                        "inverse-on-surface": "#f0f1f1",
                        "on-primary-container": "#ffffff",
                        "on-tertiary-fixed": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-error": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "on-background": "#1a1c1c",
                        "secondary": "#5f5e5e",
                        "secondary-container": "#d6d4d3",
                        "surface-container-low": "#f3f3f3",
                        "primary-fixed-dim": "#474746",
                        "surface": "#f9f9f9",
                        "inverse-surface": "#2f3131",
                        "background": "#f9f9f9",
                        "on-primary-fixed": "#ffffff",
                        "on-tertiary-container": "#ffffff",
                        "surface-container": "#eeeeee",
                        "tertiary-fixed-dim": "#464747",
                        "secondary-fixed-dim": "#acabab",
                        "on-surface": "#1a1c1c",
                        "surface-container-high": "#e8e8e8",
                        "on-surface-variant": "#474747",
                        "inverse-primary": "#c8c6c5",
                        "surface-container-highest": "#e2e2e2",
                        "secondary-fixed": "#c8c6c6",
                        "on-primary": "#e5e2e1",
                        "primary": "#000000",
                        "on-secondary-fixed": "#1b1c1c",
                        "on-secondary": "#ffffff",
                        "surface-dim": "#dadada",
                        "on-error-container": "#410002",
                        "tertiary": "#3b3b3b"
                    },
                    fontFamily: {
                        "headline": ["Manrope", "sans-serif"],
                        "body": ["Inter", "sans-serif"],
                        "label": ["Inter", "sans-serif"]
                    },
                    borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
                },
            },
        }
    </script>
<style>
        body { font-family: 'Inter', sans-serif; background-color: #f9f9f9; }
        .headline-font { font-family: 'Manrope', sans-serif; }
        .script-ghost {
            position: fixed;
            font-size: 15rem;
            color: #474747;
            opacity: 0.03;
            z-index: -1;
            pointer-events: none;
            user-select: none;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        /* Hide scrollbars for cleaner SPA feel */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-surface text-on-surface min-h-screen selection:bg-primary selection:text-on-primary overflow-x-hidden overflow-y-auto flex flex-col"
data-webrtc-whep-urls='<%- JSON.stringify(webrtcWhepUrls || {}) %>'>
<!-- Script Ghosts -->
<div class="script-ghost top-10 -left-10">अ</div>
<div class="script-ghost bottom-10 -right-10">క</div>
<div class="script-ghost top-1/2 left-1/4">म</div>
<!-- TopNavBar -->
<header class="w-full z-50 bg-white/80 backdrop-blur-xl border-b border-neutral-100 flex-none">
<nav class="flex justify-between items-center px-4 sm:px-6 lg:px-8 h-14 sm:h-16 max-w-[1440px] mx-auto">
<div class="flex items-center gap-12">
<span class="text-xl font-black tracking-tighter text-neutral-950 uppercase font-headline">
                LiveLingo
            </span>

</div>

</nav>
</header>
<!-- Main SPA Body -->
<main class="flex-1 flex flex-col lg:flex-row max-w-[1440px] mx-auto w-full overflow-visible">
<!-- Left Column: Primary Video & Controls -->
<section class="flex-1 flex flex-col p-4 sm:p-6 lg:p-8 space-y-5 sm:space-y-6 overflow-visible min-w-0">
<!-- Header Section -->
<div class="flex flex-col gap-4 sm:gap-3 sm:flex-row sm:items-end sm:justify-between">
<div class="space-y-1">
<div class="flex items-center gap-3">
<span class="bg-error text-white px-2 py-0.5 rounded-sm text-[10px] font-bold tracking-widest uppercase">Live</span>
<h1 class="text-xl sm:text-2xl font-extrabold tracking-tighter font-headline text-primary">Global Tech Summit: Keynote</h1>
</div>
<p class="text-on-surface-variant text-sm font-body">
<span id="viewer-location"><%= viewerLocation %></span> •
<span id="active-listeners-count"><%= initialLiveViewerCountLabel %></span> active listeners
</p>
</div>


</div>
<!-- Central Player -->
<div class="relative aspect-video bg-black rounded-xl overflow-hidden shadow-2xl group ring-1 ring-black/5">
<!--
  The PlayerProvider passes state between the UI components
  and Media, and makes fully custom UIs possible.
  It does not have layout by default (display:contents)
 -->
<video-player>
  <!--
    Skins contain the entire player UI and are easily swappable.
    They can each be "ejected" for full control and customization
    of UI components.
   -->
  <video-minimal-skin>
    <!--
      Media are players without UIs, handling networking
      and display of the media. They are easily swappable
      to handle different sources.
    -->
        <video id="live-video-player" src="<%= streamUrls[initialLanguage] %>" playsinline></video>
                <audio id="webrtc-audio-player" autoplay playsinline></audio>
  </video-minimal-skin>
</video-player><!-- Video Overlay UI -->

</div>
<!-- Stream Selection (SPA Controls) -->
<div class="space-y-4">
<div class="flex items-center justify-between border-b border-neutral-100 pb-2">
<h3 class="text-xs font-black uppercase tracking-widest text-primary">Stream Selection</h3>
<span class="text-[10px] text-on-surface-variant font-bold">Switching audio &amp; transcript in real-time</span>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
<% streamOptions.forEach((option) => { %>
<button class="stream-option flex flex-col gap-1 p-4 border text-left transition-all hover:border-primary"
data-language="<%= option.language %>"
data-stream-url="<%= streamUrls[option.language] || '' %>">
<span class="text-[10px] font-bold uppercase tracking-tighter text-on-surface-variant"><%= option.badge %></span>
<span class="text-lg font-headline font-bold"><%= option.label %></span>
</button>
<% }); %>
</div>
</div>
</section>
<!-- Right Column: Contextual Sidebar (Transcript/Captions) -->
<aside class="w-full lg:w-[340px] xl:w-[380px] border-l border-neutral-100 bg-white flex flex-col flex-none">
<div class="h-14 sm:h-16 px-4 sm:px-6 border-b border-neutral-100 flex items-center justify-between flex-none">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-xl">description</span>
<span class="font-headline font-bold text-sm">Real-time Transcript</span>
</div>


</div>
<!-- Transcript Content -->
<div id="transcript-list" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 no-scrollbar">
<div class="bg-surface-container-low p-4 border border-outline-variant">
<p class="text-sm text-on-surface-variant leading-relaxed">Waiting for live transcript...</p>
</div>
</div>
<!-- Sidebar Footer Actions -->


</aside>
</main>
<footer class="w-full min-h-10 px-4 sm:px-8 py-2 bg-white border-t border-neutral-100 flex items-center justify-between flex-none">
<div class="flex items-center gap-4">
<span class="text-[10px] font-black uppercase tracking-widest text-neutral-400">© LiveLingo</span>
</div>

</footer>
<script>
    (function () {
        const initialLanguage = "<%= initialLanguage %>";
        const webrtcWhepUrls = JSON.parse(document.body.dataset.webrtcWhepUrls || "{}");
        const player = document.getElementById("live-video-player");
        const webrtcAudioPlayer = document.getElementById("webrtc-audio-player");
        const activeListeners = document.getElementById("active-listeners-count");
        const transcriptList = document.getElementById("transcript-list");
        const options = Array.from(document.querySelectorAll(".stream-option"));
        const transcriptWebSocketPath = "/ws/transcripts";
        const transcriptReconnectDelayMs = 1200;
        const maxTranscriptEntries = 20;
        let transcriptSocket = null;
        let transcriptReconnectTimer = null;
        let transcriptEntries = [];
        let webrtcPeerConnection = null;
        let activeWebrtcLanguage = null;

        const selectedClasses = ["border-2", "border-primary", "bg-white"];
        const unselectedClasses = ["border", "border-outline-variant", "bg-surface-container-low"];
        const disabledClasses = ["opacity-50", "cursor-not-allowed"];

        function setOptionState(button, isSelected) {
            button.classList.remove(...selectedClasses, ...unselectedClasses);
            if (isSelected) {
                button.classList.add(...selectedClasses);
                const badge = button.querySelector("span:first-child");
                if (badge) {
                    badge.classList.remove("text-on-surface-variant");
                    badge.classList.add("text-primary", "font-black");
                }
            } else {
                button.classList.add(...unselectedClasses);
                const badge = button.querySelector("span:first-child");
                if (badge) {
                    badge.classList.remove("text-primary", "font-black");
                    badge.classList.add("text-on-surface-variant");
                }
            }
        }

        async function refreshViewerCount(language) {
            try {
                const response = await fetch(`/api/ivs/live-viewers?language=${encodeURIComponent(language)}`);
                if (!response.ok) return;

                const payload = await response.json();
                if (activeListeners && payload && payload.viewerCountLabel) {
                    activeListeners.textContent = payload.viewerCountLabel;
                }
            } catch (err) {
                // No-op: keep existing value when API is unavailable.
            }
        }

        function escapeHtml(value) {
            return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function normalizeTranscriptEntries(entries) {
            if (!Array.isArray(entries)) {
                return [];
            }

            return entries
                .filter((entry) => entry && (entry.sourceText || entry?.translations?.hindi?.text))
                .slice(-maxTranscriptEntries);
        }

        function renderTranscriptEntries(entries) {
            if (!transcriptList) return;

            if (!entries.length) {
                transcriptList.innerHTML = `
                    <div class="bg-surface-container-low p-4 border border-outline-variant">
                        <p class="text-sm text-on-surface-variant leading-relaxed">Waiting for live transcript...</p>
                    </div>
                `;
                return;
            }

            const blocks = entries.map((entry) => {
                const sourceText = (entry.sourceText || "").trim();
                const translatedText = (entry?.translations?.hindi?.text || "").trim();
                return `
                    <div class="space-y-3">
                        <p class="text-xs text-on-surface-variant leading-relaxed italic border-l-2 border-neutral-100 pl-3">${escapeHtml(sourceText || "[source unavailable]")}</p>
                        <div class="bg-surface-container-low p-4 border-l-4 border-primary">
                            <p class="text-sm font-medium text-on-surface leading-relaxed">${escapeHtml(translatedText || "[translation unavailable]")}</p>
                        </div>
                    </div>
                `;
            });

            transcriptList.innerHTML = blocks.join("");
            transcriptList.scrollTop = transcriptList.scrollHeight;
        }

        function scheduleTranscriptReconnect() {
            if (transcriptReconnectTimer) {
                clearTimeout(transcriptReconnectTimer);
            }

            transcriptReconnectTimer = setTimeout(connectTranscriptWebSocket, transcriptReconnectDelayMs);
        }

        function connectTranscriptWebSocket() {
            const protocol = window.location.protocol === "https:" ? "wss" : "ws";
            const wsUrl = `${protocol}://${window.location.host}${transcriptWebSocketPath}`;

            transcriptSocket = new WebSocket(wsUrl);

            transcriptSocket.addEventListener("message", (event) => {
                let message;

                try {
                    message = JSON.parse(event.data || "{}");
                } catch (err) {
                    return;
                }

                if (message.type === "transcript-init") {
                    transcriptEntries = normalizeTranscriptEntries(message.entries || []);
                    renderTranscriptEntries(transcriptEntries);
                    return;
                }

                if (message.type === "transcript-new" && message.entry) {
                    transcriptEntries = normalizeTranscriptEntries([...transcriptEntries, message.entry]);
                    renderTranscriptEntries(transcriptEntries);
                }
            });

            transcriptSocket.addEventListener("close", () => {
                scheduleTranscriptReconnect();
            });

            transcriptSocket.addEventListener("error", () => {
                if (transcriptSocket && transcriptSocket.readyState === WebSocket.OPEN) {
                    transcriptSocket.close();
                }
            });
        }

        function waitForIceGatheringComplete(peerConnection, timeoutMs = 3000) {
            if (!peerConnection || peerConnection.iceGatheringState === "complete") {
                return Promise.resolve();
            }

            return new Promise((resolve) => {
                let timeoutId;

                function onStateChange() {
                    if (peerConnection.iceGatheringState === "complete") {
                        clearTimeout(timeoutId);
                        peerConnection.removeEventListener("icegatheringstatechange", onStateChange);
                        resolve();
                    }
                }

                timeoutId = setTimeout(() => {
                    peerConnection.removeEventListener("icegatheringstatechange", onStateChange);
                    resolve();
                }, timeoutMs);

                peerConnection.addEventListener("icegatheringstatechange", onStateChange);
            });
        }

        function stopWebrtcAudio() {
            activeWebrtcLanguage = null;

            if (webrtcPeerConnection) {
                webrtcPeerConnection.close();
                webrtcPeerConnection = null;
            }

            if (webrtcAudioPlayer) {
                webrtcAudioPlayer.pause();
                webrtcAudioPlayer.srcObject = null;
            }

            if (player) {
                player.muted = false;
            }
        }

        async function startWebrtcAudio(language) {
            const whepUrl = String(webrtcWhepUrls?.[language] || "").trim();
            if (!whepUrl || !window.RTCPeerConnection || !webrtcAudioPlayer) {
                stopWebrtcAudio();
                return false;
            }

            if (activeWebrtcLanguage === language && webrtcPeerConnection) {
                return true;
            }

            stopWebrtcAudio();

            try {
                const peerConnection = new RTCPeerConnection({
                    iceServers: [{ urls: "stun:stun.l.google.com:19302" }],
                });

                peerConnection.addTransceiver("audio", { direction: "recvonly" });
                peerConnection.addEventListener("track", (event) => {
                    const [stream] = event.streams || [];
                    if (!stream) return;
                    webrtcAudioPlayer.srcObject = stream;
                    webrtcAudioPlayer.play().catch(() => {});
                });

                const offer = await peerConnection.createOffer({
                    offerToReceiveAudio: true,
                    offerToReceiveVideo: false,
                });
                await peerConnection.setLocalDescription(offer);
                await waitForIceGatheringComplete(peerConnection);

                const response = await fetch(whepUrl, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/sdp",
                    },
                    body: peerConnection.localDescription?.sdp || "",
                });

                if (!response.ok) {
                    throw new Error(`WHEP handshake failed: ${response.status}`);
                }

                const answerSdp = await response.text();
                await peerConnection.setRemoteDescription({ type: "answer", sdp: answerSdp });

                webrtcPeerConnection = peerConnection;
                activeWebrtcLanguage = language;

                if (player) {
                    player.muted = true;
                }

                return true;
            } catch (err) {
                stopWebrtcAudio();
                return false;
            }
        }

        async function activateStream(language) {
            const selectedButton = options.find((button) => button.dataset.language === language);
            if (!selectedButton) return;

            const selectedUrl = selectedButton.dataset.streamUrl;
            if (!selectedUrl || !player) return;

            if (player.getAttribute("src") !== selectedUrl) {
                player.setAttribute("src", selectedUrl);
                player.load();
                player.play().catch(() => {});
            }

            options.forEach((button) => setOptionState(button, button === selectedButton));
            refreshViewerCount(language);
            await startWebrtcAudio(language);
        }

        options.forEach((button) => {
            const streamUrl = button.dataset.streamUrl;

            if (!streamUrl) {
                button.classList.add(...disabledClasses);
                button.setAttribute("disabled", "disabled");
                return;
            }

            button.addEventListener("click", () => {
                activateStream(button.dataset.language);
            });
        });

        activateStream(initialLanguage);
        connectTranscriptWebSocket();
    })();
</script>
</body></html>